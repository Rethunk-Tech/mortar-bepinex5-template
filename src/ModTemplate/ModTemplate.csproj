<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ModXmlIdPrefix.ModTemplate</AssemblyName>
    <AssemblyTitle>ModTemplate</AssemblyTitle>
    <RootNamespace>ModTemplate</RootNamespace>
    <RepositoryUrl>ModRepositoryUrl</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <IsThunderstorePackable>true</IsThunderstorePackable>
    <ThunderstoreName>ModTemplate</ThunderstoreName>
    <ThunderstoreDescription>ModXmlDescription</ThunderstoreDescription>
    <ThunderstoreCommunities>lethal-company</ThunderstoreCommunities>
    <ThunderstoreCategories>ModCategories</ThunderstoreCategories>
  </PropertyGroup>

  <ItemGroup>
    <ModFile Include="$(TargetPath)" Destination="plugins/" />
  </ItemGroup>

  <ItemGroup>
    <ThunderstorePackageFile Include="$(SolutionRoot)README.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)CHANGELOG.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)icon.png" />
    <ThunderstorePackageFile Include="$(SolutionRoot)LICENSE" />
    <ThunderstoreDependency Include="BepInEx-BepInExPack" Version="5.4.2305" />
    <!--#if (configSync) -->
    <ThunderstoreDependency Include="Mortar-ConfigSync" Version="0.1.0" />
    <!--#endif -->
  </ItemGroup>
  <!--#if (unsharable) -->

  <!-- Fail before anything gets downloaded. -->
  <Target Name="RefuseUnsharable" BeforeTargets="PrepareForBuild">
    <Error Text="configSync needs config on and audience everyone, since every player has to have a shared setting." />
  </Target>
  <!--#endif -->
</Project>
