{
  "$schema": "http://json.schemastore.org/template",
  "author": "Rethunk Tech",
  "identity": "Mortar.BepInEx5.LethalCompany",
  "name": "BepInEx 5 mod for Lethal Company",
  "description": "A BepInEx 5 mod for Lethal Company. Its name (-n) is letters and digits, starting with a capital, since it becomes the folder, project and class names.",
  "shortName": "mortar-lc-bepinex5",
  "classifications": [
    "Game",
    "Mod",
    "BepInEx"
  ],
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "ModTemplate",
  "preferNameDirectory": true,
  "sources": [
    {
      "modifiers": [
        {
          "include": [
            "**/packages.lock.json"
          ],
          "exclude": [
            "**/.git/**",
            "artifacts/**",
            "tests/**",
            ".github/workflows/template.yml",
            "Config.Build.user.props",
            "**/.idea/**",
            "**/.vs/**",
            "**/bin/**",
            "**/obj/**",
            ".github/README.md"
          ]
        },
        {
          "condition": "(!netcode)",
          "exclude": [
            "src/ModTemplate/Netcode.cs"
          ]
        },
        {
          "condition": "(!assets)",
          "exclude": [
            "assets/**"
          ]
        }
      ]
    }
  ],
  "symbols": {
    "description": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": true,
      "description": "What the mod does, in one line.",
      "replaces": "ModDescription",
      "displayName": "Description"
    },
    "xmlDescription": {
      "type": "derived",
      "valueSource": "description",
      "valueTransform": "msbuildXml",
      "replaces": "ModXmlDescription"
    },
    "modAuthor": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": true,
      "description": "Who holds the copyright.",
      "replaces": "ModAuthor",
      "displayName": "Author"
    },
    "xmlAuthor": {
      "type": "derived",
      "valueSource": "modAuthor",
      "valueTransform": "msbuildXml",
      "replaces": "ModXmlAuthor"
    },
    "team": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": true,
      "description": "The team the mod is published under.",
      "replaces": "ModTeam",
      "displayName": "Thunderstore team"
    },
    "xmlTeam": {
      "type": "derived",
      "valueSource": "team",
      "valueTransform": "msbuildXml",
      "replaces": "ModXmlTeam"
    },
    "idPrefix": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": true,
      "description": "Start of the plugin GUID, such as com.yourname.",
      "displayName": "Id prefix"
    },
    "xmlIdPrefix": {
      "type": "derived",
      "valueSource": "idPrefix",
      "valueTransform": "msbuildXml",
      "replaces": "ModXmlIdPrefix"
    },
    "audience": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "everyone",
      "description": "Who needs the mod installed.",
      "choices": [
        {
          "choice": "everyone",
          "displayName": "Everyone in the lobby"
        },
        {
          "choice": "host",
          "displayName": "Only the host"
        },
        {
          "choice": "client",
          "displayName": "Client-side only"
        }
      ],
      "displayName": "Who needs it"
    },
    "categories": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "defaultValue": "mods|bepinex",
      "description": "Where the mod is listed on Thunderstore.",
      "choices": [
        {
          "choice": "mods",
          "displayName": "Mods"
        },
        {
          "choice": "bepinex",
          "displayName": "BepInEx"
        },
        {
          "choice": "clientside",
          "displayName": "Client-side"
        },
        {
          "choice": "serverside",
          "displayName": "Server-side"
        },
        {
          "choice": "tweaks-and-quality-of-life",
          "displayName": "Tweaks & Quality Of Life"
        },
        {
          "choice": "bug-fixes",
          "displayName": "Bug Fixes"
        },
        {
          "choice": "performance",
          "displayName": "Performance"
        },
        {
          "choice": "items",
          "displayName": "Items"
        },
        {
          "choice": "equipment",
          "displayName": "Equipment"
        },
        {
          "choice": "monsters",
          "displayName": "Monsters"
        },
        {
          "choice": "moons",
          "displayName": "Moons"
        },
        {
          "choice": "interiors",
          "displayName": "Interiors"
        },
        {
          "choice": "hazards",
          "displayName": "Hazards"
        },
        {
          "choice": "weather",
          "displayName": "Weather"
        },
        {
          "choice": "vehicles",
          "displayName": "Vehicles"
        },
        {
          "choice": "cosmetics",
          "displayName": "Cosmetics"
        },
        {
          "choice": "suits",
          "displayName": "Suits"
        },
        {
          "choice": "emotes",
          "displayName": "Emotes"
        },
        {
          "choice": "furniture",
          "displayName": "Furniture"
        },
        {
          "choice": "audio",
          "displayName": "Audio"
        },
        {
          "choice": "translations",
          "displayName": "Translations"
        },
        {
          "choice": "asset-replacements",
          "displayName": "Asset Replacements"
        },
        {
          "choice": "libraries",
          "displayName": "Libraries"
        },
        {
          "choice": "tools",
          "displayName": "Tools"
        },
        {
          "choice": "misc",
          "displayName": "Misc"
        },
        {
          "choice": "poster",
          "displayName": "Posters"
        },
        {
          "choice": "boombox",
          "displayName": "Boombox Music"
        },
        {
          "choice": "video",
          "displayName": "TV Videos"
        },
        {
          "choice": "ai-generated",
          "displayName": "AI Generated"
        }
      ],
      "displayName": "Categories"
    },
    "categoryList": {
      "type": "derived",
      "valueSource": "categories",
      "valueTransform": "semicolons",
      "replaces": "ModCategories"
    },
    "repositoryUrl": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "The mod's source repository.",
      "displayName": "Repository"
    },
    "xmlRepositoryUrl": {
      "type": "derived",
      "valueSource": "repositoryUrl",
      "valueTransform": "msbuildXml",
      "replaces": "ModRepositoryUrl"
    },
    "loaderPackVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "5.4.2305",
      "description": "BepInExPack version the mod depends on.",
      "replaces": "5.4.2305",
      "displayName": "BepInExPack version"
    },
    "year": {
      "type": "generated",
      "generator": "now",
      "replaces": "ModYear",
      "parameters": {
        "format": "yyyy"
      }
    },
    "netcodeId": {
      "type": "generated",
      "generator": "random",
      "parameters": {
        "low": 1,
        "high": 2147483647
      },
      "replaces": "2142302400"
    },
    "netcode": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Uses netcode",
      "description": "Adds NetcodePatcher and a networked object, so [ServerRpc] and [ClientRpc] methods work."
    },
    "assets": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Uses asset bundles",
      "description": "Ships the bundles in assets/ beside the plugin and loads one in Awake."
    },
    "config": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Has settings",
      "description": "Adds one example setting to the mod's config file."
    },
    "unsharable": {
      "type": "computed",
      "value": "(configSync && (!config || audience != \"everyone\"))"
    },
    "configSync": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Shares settings with the lobby",
      "description": "Adds a setting where the host's value applies to every player, using Mortar-ConfigSync. Needs settings on and audience set to everyone."
    }
  },
  "forms": {
    "xml": {
      "identifier": "xmlEncode"
    },
    "semicolons": {
      "identifier": "replace",
      "pattern": "\\|",
      "replacement": ";"
    },
    "msPercent": {
      "identifier": "replace",
      "pattern": "%",
      "replacement": "%25"
    },
    "msDollar": {
      "identifier": "replace",
      "pattern": "\\$",
      "replacement": "%24"
    },
    "msAt": {
      "identifier": "replace",
      "pattern": "@",
      "replacement": "%40"
    },
    "msSemicolon": {
      "identifier": "replace",
      "pattern": ";",
      "replacement": "%3B"
    },
    "msQuote": {
      "identifier": "replace",
      "pattern": "'",
      "replacement": "%27"
    },
    "msStar": {
      "identifier": "replace",
      "pattern": "\\*",
      "replacement": "%2A"
    },
    "msQuestion": {
      "identifier": "replace",
      "pattern": "\\?",
      "replacement": "%3F"
    },
    "msbuildXml": {
      "identifier": "chain",
      "steps": [
        "msPercent",
        "msDollar",
        "msAt",
        "msSemicolon",
        "msQuote",
        "msStar",
        "msQuestion",
        "xml"
      ]
    }
  }
}
